<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- OpenAI.Responses contains APIs marked experimental by the SDK; this project intentionally uses them. -->
    <NoWarn>$(NoWarn);OPENAI001;SCME0002</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NexusTelecommunicationManagementSystem</RootNamespace>
    <UserSecretsId>e7f7ef75-d70d-4c66-9cd3-78844e0e83db</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="OpenAI" Version="2.12.0" />
  </ItemGroup>
</Project>
