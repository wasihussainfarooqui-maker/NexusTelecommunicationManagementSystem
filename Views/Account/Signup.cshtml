@model SignupViewModel
@{ ViewData["Title"]="Create account"; }
<section class="page-hero compact"><div class="container reveal"><span class="eyebrow">CUSTOMER REGISTRATION</span><h1>Create your<br /><em>NEXUS account.</em></h1><p>Customer signup is open. Administrator accounts are provisioned separately.</p></div></section>
<section class="section form-section"><div class="container narrow"><div class="form-card reveal"><form asp-action="Signup" method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="grid-form"><label>Username<input asp-for="Username" autocomplete="username" required /></label><label>Full name<input asp-for="FullName" autocomplete="name" required /></label><label>Email<input asp-for="Email" type="email" autocomplete="email" required /></label><label>Contact<input asp-for="Contact" required /></label><label>City<input asp-for="City" required /></label><label>Address<input asp-for="Address" required /></label><label>Password<input asp-for="Password" type="password" autocomplete="new-password" required /></label><label>Confirm password<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required /></label></div><button class="button button-primary full-button" type="submit">Create customer account <span>↗</span></button></form></div></div></section>
