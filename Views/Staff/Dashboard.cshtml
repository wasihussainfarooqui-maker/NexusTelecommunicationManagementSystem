@model StaffDashboardViewModel
@{ ViewData["Title"] = Model.Role + " Workspace"; var role = Model.Role.ToLowerInvariant(); var firstName = Model.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? Model.Name; }
<div class="staff-workspace">
    <section class="staff-hero-pro reveal">
        <div class="staff-identity">
            <div class="staff-avatar">@firstName[..Math.Min(1, firstName.Length)].ToUpperInvariant()</div>
            <div><span class="eyebrow">NEXUS OPERATIONS · @Model.Role.ToUpperInvariant()</span><h1>Good to see you, <em>@firstName</em>.</h1><p>Your workspace is configured for <strong>@Model.Role</strong> operations. You can edit the records assigned to your role below.</p></div>
        </div>
        <div class="staff-actions"><span class="staff-status"><i></i> Active session</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="mini-btn" type="submit">Sign out</button></form></div>
    </section>

    @if (TempData["StaffMessage"] is string msg) { <div class="staff-alert">✓ @msg</div> }

    <section class="staff-kpis reveal">
        @if (role.Contains("technical")) {
            <div><span>Pending feasibility</span><b>@Model.PendingOrders</b><small>Needs technical review</small></div><div><span>Installations</span><b>@Model.ScheduledInstallations</b><small>Scheduled jobs</small></div><div><span>Active links</span><b>@Model.ActiveConnections</b><small>Network connections</small></div><div><span>Low stock</span><b>@Model.LowStock</b><small>Reorder required</small></div>
        } else if (role.Contains("account")) {
            <div><span>Outstanding accounts</span><b>@Model.OutstandingBills</b><small>With an unpaid balance</small></div><div><span>Outstanding</span><b>Rs @Model.OutstandingAmount.ToString("N0")</b><small>Total customer balance</small></div><div><span>Connections</span><b>@Model.ActiveConnections</b><small>Active services</small></div><div><span>Customers</span><b>@Model.Customers</b><small>Customer records</small></div>
        } else if (role.Contains("retail") || role.Contains("sales")) {
            <div><span>Open applications</span><b>@Model.OpenOrders</b><small>Sales pipeline</small></div><div><span>Customers</span><b>@Model.Customers</b><small>Profiles available</small></div><div><span>Active connections</span><b>@Model.ActiveConnections</b><small>Existing services</small></div><div><span>Tickets</span><b>@Model.OpenTickets</b><small>Customer follow-up</small></div>
        } else if (role.Contains("support")) {
            <div><span>Open tickets</span><b>@Model.OpenTickets</b><small>Requires attention</small></div><div><span>Customers</span><b>@Model.Customers</b><small>Customer profiles</small></div><div><span>Active services</span><b>@Model.ActiveConnections</b><small>Connected accounts</small></div><div><span>Open orders</span><b>@Model.OpenOrders</b><small>Service requests</small></div>
        } else if (role.Contains("inventory")) {
            <div><span>Stock items</span><b>@Model.Equipment.Count</b><small>Managed SKUs</small></div><div><span>Low stock</span><b>@Model.LowStock</b><small>Reorder required</small></div><div><span>Active connections</span><b>@Model.ActiveConnections</b><small>Network footprint</small></div><div><span>Orders</span><b>@Model.OpenOrders</b><small>Operational demand</small></div>
        } else {
            <div><span>Open orders</span><b>@Model.OpenOrders</b><small>Operational queue</small></div><div><span>Connections</span><b>@Model.ActiveConnections</b><small>Active services</small></div><div><span>Customers</span><b>@Model.Customers</b><small>Customer records</small></div><div><span>Tickets</span><b>@Model.OpenTickets</b><small>Service issues</small></div>
        }
    </section>

    @if (role.Contains("technical")) {
        <section class="staff-section reveal"><div class="section-title"><div><span class="eyebrow">TECHNICAL QUEUE</span><h2>Feasibility & installation control</h2></div><span class="section-count">@Model.Orders.Count jobs</span></div>
            <div class="work-grid">@foreach(var x in Model.Orders){<article class="work-card"><div class="work-top"><span class="work-code">@x.OrderCode</span><span class="status">@x.Status</span></div><h3>@x.CustomerName</h3><p>@x.Plan.Name · @x.Address</p><form asp-action="UpdateOrder" method="post" class="edit-form"><input type="hidden" name="code" value="@x.OrderCode"/><label>Status<select name="status"><option>Pending</option><option selected="@(x.Status==OrderStatus.Feasible?"selected":null)">Feasible</option><option selected="@(x.Status==OrderStatus.InstallationScheduled?"selected":null)">InstallationScheduled</option><option selected="@(x.Status==OrderStatus.Connected?"selected":null)">Connected</option><option>NotFeasible</option></select></label><label>Technical note<input name="note" value="@x.FeasibilityNote"/></label><button class="button button-dark" type="submit">Save technical update</button></form></article>}</div>
        </section>
        <section class="staff-section reveal"><div class="section-title"><div><span class="eyebrow">NETWORK CONTROL</span><h2>Live connections</h2></div></div><div class="table-wrap"><table class="pro-table"><thead><tr><th>Account</th><th>Customer</th><th>Plan</th><th>Status</th><th>Due</th><th>Edit</th></tr></thead><tbody>@foreach(var x in Model.Connections){<tr><td><b>@x.AccountId</b></td><td>@x.CustomerName</td><td>@x.Plan.Name</td><td><span class="status">@x.Status</span></td><td>Rs @x.AmountDue.ToString("N0")</td><td><details><summary>Edit</summary><form asp-action="UpdateConnection" method="post" class="compact-form"><input type="hidden" name="accountId" value="@x.AccountId"/><select name="status"><option selected="@(x.Status==ConnectionStatus.Active?"selected":null)">Active</option><option selected="@(x.Status==ConnectionStatus.TemporarilyInactive?"selected":null)">TemporarilyInactive</option><option selected="@(x.Status==ConnectionStatus.PermanentlyInactive?"selected":null)">PermanentlyInactive</option></select><input type="number" step="0.01" name="amountDue" value="@x.AmountDue"/><button type="submit">Save</button></form></details></td></tr>}</tbody></table></div></section>
        <section class="staff-section reveal"><div class="section-title"><div><span class="eyebrow">EQUIPMENT</span><h2>Field stock</h2></div></div><div class="work-grid equipment-grid">@foreach(var x in Model.Equipment){<article class="work-card"><div class="work-top"><span class="work-code">@x.Category</span><span class="stock-pill @(x.Quantity<=x.ReorderLevel?"low":"ok")">@x.Status</span></div><h3>@x.Name</h3><p>Vendor: @x.Vendor</p><form asp-action="UpdateEquipment" method="post" class="edit-form"><input type="hidden" name="id" value="@x.Id"/><div class="two-input"><label>Qty<input type="number" min="0" name="quantity" value="@x.Quantity"/></label><label>Reorder<input type="number" min="0" name="reorderLevel" value="@x.ReorderLevel"/></label></div><button class="button button-dark" type="submit">Update stock</button></form></article>}</div></section>
    } else if (role.Contains("account")) {
        <section class="staff-section reveal"><div class="section-title"><div><span class="eyebrow">ACCOUNTS DESK</span><h2>Billing work queue</h2></div><span class="section-count">@Model.Bills.Count records</span></div><div class="table-wrap"><table class="pro-table"><thead><tr><th>Bill</th><th>Account</th><th>Amount</th><th>Paid</th><th>Due date</th><th>Status</th><th>Edit</th></tr></thead><tbody>@foreach(var x in Model.Bills){<tr><td><b>@x.BillNumber</b></td><td>@x.AccountId</td><td>Rs @x.Amount.ToString("N0")</td><td>Rs @x.Paid.ToString("N0")</td><td>@x.DueDate.ToString("dd MMM yyyy")</td><td><span class="status">@x.Status</span></td><td><details><summary>Edit</summary><form asp-action="UpdateBill" method="post" class="compact-form"><input type="hidden" name="id" value="@x.Id"/><input type="number" step="0.01" name="amount" value="@x.Amount"/><input type="number" step="0.01" name="paid" value="@x.Paid"/><input type="date" name="dueDate" value="@x.DueDate.ToString("yyyy-MM-dd")"/><button type="submit">Save</button></form></details></td></tr>}</tbody></table></div></section>
        <section class="staff-section reveal"><div class="section-title"><div><span class="eyebrow">CUSTOMER RECORDS</span><h2>Account contacts</h2></div></div><div class="work-grid">@foreach(var x in Model.CustomersList.Take(12)){<article class="work-card"><span class="eyebrow">@x.AccountId</span><h3>@x.Name</h3><p>@x.Email · @x.Contact</p><details><summary>Edit customer</summary><form asp-action="UpdateCustomer" method="post" class="edit-form"><input type="hidden" name="id" value="@x.Id"/><input name="name" value="@x.Name"/><input name="email" value="@x.Email"/><input name="contact" value="@x.Contact"/><input name="address" value="@x.Address"/><input name="city" value="@x.City"/><button class="button button-dark" type="submit">Save customer</button></form></details></article>}</div></section>
    } else if (role.Contains("retail") || role.Contains("sales")) {
        <section class="staff-section reveal"><div class="section-title"><div><span class="eyebrow">SALES PIPELINE</span><h2>Customer applications</h2></div><span class="section-count">@Model.Orders.Count applications</span></div><div class="work-grid">@foreach(var x in Model.Orders){<article class="work-card"><div class="work-top"><span class="work-code">@x.OrderCode</span><span class="status">@x.Status</span></div><h3>@x.CustomerName</h3><p>@x.Plan.Name · @x.Contact · @x.Address</p><form asp-action="UpdateOrder" method="post" class="edit-form"><input type="hidden" name="code" value="@x.OrderCode"/><label>Application status<select name="status"><option selected="@(x.Status==OrderStatus.Pending?"selected":null)">Pending</option><option selected="@(x.Status==OrderStatus.Feasible?"selected":null)">Feasible</option><option selected="@(x.Status==OrderStatus.InstallationScheduled?"selected":null)">InstallationScheduled</option><option selected="@(x.Status==OrderStatus.Connected?"selected":null)">Connected</option><option>Cancelled</option></select></label><label>Sales note<input name="note" value="@x.FeasibilityNote"/></label><button class="button button-dark" type="submit">Save application</button></form></article>}</div></section>
        <section class="staff-section reveal"><div class="section-title"><div><span class="eyebrow">CUSTOMER MANAGEMENT</span><h2>Editable customer profiles</h2></div></div><div class="work-grid">@foreach(var x in Model.CustomersList.Take(12)){<article class="work-card"><h3>@x.Name</h3><p>@x.Username · @x.Email</p><details><summary>Edit profile</summary><form asp-action="UpdateCustomer" method="post" class="edit-form"><input type="hidden" name="id" value="@x.Id"/><input name="name" value="@x.Name"/><input name="email" value="@x.Email"/><input name="contact" value="@x.Contact"/><input name="address" value="@x.Address"/><input name="city" value="@x.City"/><button class="button button-dark" type="submit">Save profile</button></form></details></article>}</div></section>
    } else if (role.Contains("support")) {
        <section class="staff-section reveal"><div class="section-title"><div><span class="eyebrow">SERVICE DESK</span><h2>Support ticket queue</h2></div><span class="section-count">@Model.Tickets.Count active</span></div><div class="work-grid">@foreach(var x in Model.Tickets){<article class="work-card"><div class="work-top"><span class="work-code">#@x.Id.ToString("0000")</span><span class="status">@x.Status</span></div><h3>@x.Name</h3><p>@x.Email · @x.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</p><div class="ticket-message">@x.Message</div><form asp-action="UpdateTicket" method="post" class="compact-form"><input type="hidden" name="id" value="@x.Id"/><select name="status"><option selected="@(x.Status=="Open"?"selected":null)">Open</option><option selected="@(x.Status=="In Progress"?"selected":null)">In Progress</option><option selected="@(x.Status=="Waiting Customer"?"selected":null)">Waiting Customer</option><option selected="@(x.Status=="Closed"?"selected":null)">Closed</option></select><button type="submit">Update ticket</button></form></article>}</div></section>
        <section class="staff-section reveal"><div class="section-title"><div><span class="eyebrow">CUSTOMER CARE</span><h2>Customer profiles</h2></div></div><div class="work-grid">@foreach(var x in Model.CustomersList.Take(12)){<article class="work-card"><h3>@x.Name</h3><p>@x.Email · @x.Contact</p><details><summary>Edit profile</summary><form asp-action="UpdateCustomer" method="post" class="edit-form"><input type="hidden" name="id" value="@x.Id"/><input name="name" value="@x.Name"/><input name="email" value="@x.Email"/><input name="contact" value="@x.Contact"/><input name="address" value="@x.Address"/><input name="city" value="@x.City"/><button class="button button-dark" type="submit">Save profile</button></form></details></article>}</div></section>
    } else if (role.Contains("inventory")) {
        <section class="staff-section reveal"><div class="section-title"><div><span class="eyebrow">INVENTORY CONTROL</span><h2>Editable equipment register</h2></div><span class="section-count">@Model.Equipment.Count items</span></div><div class="work-grid equipment-grid">@foreach(var x in Model.Equipment){<article class="work-card"><div class="work-top"><span class="work-code">@x.Category</span><span class="stock-pill @(x.Quantity<=x.ReorderLevel?"low":"ok")">@x.Status</span></div><h3>@x.Name</h3><form asp-action="UpdateEquipment" method="post" class="edit-form"><input type="hidden" name="id" value="@x.Id"/><input name="name" value="@x.Name"/><input name="category" value="@x.Category"/><div class="two-input"><label>Quantity<input type="number" min="0" name="quantity" value="@x.Quantity"/></label><label>Reorder level<input type="number" min="0" name="reorderLevel" value="@x.ReorderLevel"/></label></div><input name="vendor" value="@x.Vendor"/><button class="button button-dark" type="submit">Save inventory item</button></form></article>}</div></section>
    } else {
        <section class="staff-section reveal"><div class="empty-staff"><span class="eyebrow">WORKSPACE READY</span><h2>@Model.Role operations</h2><p>Your account is active. Ask an administrator to assign a supported operational role if you need additional tools.</p></div></section>
    }

    <section class="staff-footer-card reveal"><div><span class="eyebrow">ACCOUNT</span><h3>@Model.Name</h3><p>@Model.Username · @Model.Email</p></div><div><span class="eyebrow">ACCESS</span><p>Role-based permissions are enforced on the server. Admin can change your role, status, username and password from the Employees panel.</p></div></section>
</div>
