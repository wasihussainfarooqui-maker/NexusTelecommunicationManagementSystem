@{ ViewData["Title"] = "Application received"; }
<section class="success-page"><div class="success-card reveal"><div class="success-mark">✓</div><span class="eyebrow">APPLICATION RECEIVED</span><h1>Your order is in the system.</h1><p>Keep this unique order ID. You can use it any time to check the status of your application.</p><div class="order-code">@ViewBag.Code</div><div class="button-row center"><a class="button button-primary" asp-controller="Track" asp-action="Index" asp-route-code="@ViewBag.Code">Track order</a><a class="button button-ghost" asp-controller="Home" asp-action="Index">Back home</a></div></div></section>
