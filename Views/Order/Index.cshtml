@model NewOrderViewModel
@inject NexusService Nexus
@{ ViewData["Title"] = "New connection"; var selected = Nexus.GetPlan(Model.PlanId) ?? Nexus.Plans.First(); }
<section class="page-hero compact"><div class="container reveal"><span class="eyebrow">NEW CONNECTION</span><h1>Start your<br /><em>application.</em></h1><p>Enter your details below. A unique order ID is generated immediately so you can track your application.</p></div></section>
<section class="section form-section"><div class="container form-layout"><div class="form-side reveal"><span class="eyebrow">SELECTED PLAN</span><div class="selected-plan"><span class="tag">@selected.ConnectionType</span><h2>@selected.Name</h2><p>@selected.Description</p><strong>$@selected.Price.ToString("0") <small>/ @selected.BillingCycle.ToLowerInvariant()</small></strong></div><div class="mini-note"><b>What happens next?</b><span>1. Application received</span><span>2. Feasibility reviewed</span><span>3. Connection scheduled if feasible</span></div></div><div class="form-card reveal"><form asp-action="Index" method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><input type="hidden" asp-for="PlanId" /><label>Full name<input asp-for="FullName" placeholder="Your full name" /></label><label>Email address<input asp-for="Email" type="email" placeholder="you@example.com" /></label><label>Contact number<input asp-for="Contact" placeholder="03xx-xxxxxxx" /></label><label>Service address<textarea asp-for="Address" rows="4" placeholder="Where should the connection be installed?"></textarea></label><button class="button button-primary full-button" type="submit">Submit application <span>↗</span></button></form></div></div></section>
