@model IReadOnlyList<Bill>
@{ ViewData["Title"] = "Bills"; }
<section class="page-hero compact"><div class="container reveal"><span class="eyebrow">MY BILLS</span><h1>Billing, made<br /><em>clear.</em></h1><p>Review your current charges, paid amounts and outstanding balance.</p></div></section>
<section class="section"><div class="container"><div class="bill-list reveal">@foreach (var bill in Model) {<article class="bill-row"><div><span class="eyebrow">@bill.BillNumber</span><h3>@bill.DueDate.ToString("dd MMM yyyy")</h3></div><div><span>Amount</span><b>$@bill.Amount.ToString("0.00")</b></div><div><span>Paid</span><b>$@bill.Paid.ToString("0.00")</b></div><div><span>Due</span><b>$@bill.Due.ToString("0.00")</b></div><span class="status status-@bill.Status.ToLowerInvariant()">@bill.Status</span></article>}</div><div class="tax-note reveal"><b>Billing note</b><p>Plan charges and applicable government service tax are reflected in the generated bill. The project specification states a 12.24% service tax on the whole bill.</p></div></div></section>
