@{ 
    var currentRole = Context.Session.GetString("Role") ?? "";
    var isAdmin = currentRole.Equals("Admin", StringComparison.OrdinalIgnoreCase) && ViewContext.RouteData.Values["controller"]?.ToString()?.Equals("Admin", StringComparison.OrdinalIgnoreCase) == true;
    var isStaff = !string.IsNullOrWhiteSpace(currentRole) && !currentRole.Equals("Customer", StringComparison.OrdinalIgnoreCase) && !currentRole.Equals("Admin", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#07110e" />
    <title>@ViewData["Title"] · NEXUS Telecommunication</title>
    <link rel="stylesheet" href="@(isAdmin ? Url.Content("~/css/admin.css") : Url.Content("~/css/site.css"))" asp-append-version="true" />
</head>
<body>
@if (isAdmin) {
<header class="topbar"><a class="brand" asp-controller="Admin" asp-action="Index"><span class="brand-mark">N</span><span><b>NEXUS</b><small>TELECOMMUNICATION MANAGEMENT</small></span></a><button class="menu-btn" onclick="toggleSidebar()">☰</button><div class="top-actions"><span class="admin-pill">● ADMIN</span><span class="date">@DateTime.Now.ToString("dd MMM yyyy")</span><form asp-controller="Account" asp-action="Logout" method="post" style="display:inline"><button class="mini-btn" type="submit">Logout</button></form></div></header>
<div class="app-shell"><aside id="sidebar" class="sidebar"><div class="side-label">CONTROL CENTER</div><a class="nav-link" asp-controller="Admin" asp-action="Index"><span>⌂</span> Overview</a><a class="nav-link" asp-controller="Admin" asp-action="Orders"><span>↗</span> Orders</a><a class="nav-link" asp-controller="Admin" asp-action="Connections"><span>◉</span> Connections</a><a class="nav-link" asp-controller="Admin" asp-action="Customers"><span>◎</span> Customers</a><a class="nav-link" asp-controller="Admin" asp-action="Plans"><span>◇</span> Plans</a><a class="nav-link" asp-controller="Admin" asp-action="Billing"><span>▣</span> Billing</a><div class="side-label">OPERATIONS</div><a class="nav-link" asp-controller="Admin" asp-action="Employees"><span>♙</span> Employees</a><a class="nav-link" asp-controller="Admin" asp-action="Equipment"><span>▤</span> Equipment / Stock</a><a class="nav-link" asp-controller="Admin" asp-action="Vendors"><span>◈</span> Vendors</a><a class="nav-link" asp-controller="Admin" asp-action="Shops"><span>⌖</span> Retail Shops</a><div class="side-bottom"><div class="security">✓ Secure admin workspace</div></div></aside><main class="content">@RenderBody()</main></div>
} else if (isStaff) {
<header class="staff-topbar"><div class="staff-top-inner"><a class="brand" asp-controller="Staff" asp-action="Dashboard"><span class="brand-icon">N</span><span><b>NEXUS</b><small>STAFF OPERATIONS</small></span></a><div class="staff-top-meta"><span class="staff-role-chip">● @currentRole</span><span class="staff-user">@Context.Session.GetString("FullName")</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="mini-btn" type="submit">Sign out</button></form></div></div></header>
<div class="staff-app-shell"><aside class="staff-sidebar"><div class="side-label">MY WORKSPACE</div><a class="staff-nav active" asp-controller="Staff" asp-action="Dashboard">▦ <span>Dashboard</span></a><div class="side-label">NEXUS</div><a class="staff-nav" asp-controller="Home" asp-action="Index">↗ <span>Customer site</span></a><a class="staff-nav" asp-controller="Chat" asp-action="Index">✦ <span>AI support</span></a><div class="staff-sidebar-foot"><span>@currentRole access</span><small>Role permissions are enforced by the server.</small></div></aside><main class="staff-content">@RenderBody()</main></div>
} else {
<header class="site-header"><div class="container nav-wrap"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-icon">N</span><span><b>NEXUS</b><small>TELECOMMUNICATION</small></span></a><button class="mobile-toggle" type="button" aria-label="Open menu" aria-expanded="false" onclick="toggleMenu(this)">☰</button><nav id="mainNav" class="main-nav"><a asp-controller="Home" asp-action="Index">Home</a><a asp-controller="Plans" asp-action="Index">Plans</a><a asp-controller="Track" asp-action="Index">Track</a><a asp-controller="Dashboard" asp-action="Index">My Portal</a><a asp-controller="Support" asp-action="Index">Support</a><a asp-controller="Chat" asp-action="Index">AI Help</a>@if(currentRole.Equals("Customer", StringComparison.OrdinalIgnoreCase)){<form asp-controller="Account" asp-action="Logout" method="post" style="display:inline"><button class="nav-cta" type="submit">Logout</button></form>}else{<a asp-controller="Account" asp-action="Login">Sign in</a><a asp-controller="Account" asp-action="StaffLogin">Staff login</a><a class="nav-cta" asp-controller="Account" asp-action="Signup">Create account <span>↗</span></a>}</nav></div></header><main>@RenderBody()</main><footer class="site-footer"><div class="container footer-grid"><div><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-icon">N</span><span><b>NEXUS</b><small>TELECOMMUNICATION</small></span></a><p>Reliable connectivity. Simple service management.</p></div><div><span class="footer-label">Customer</span><a asp-controller="Plans" asp-action="Index">Plans</a><a asp-controller="Order" asp-action="Index">New connection</a><a asp-controller="Track" asp-action="Index">Track order</a></div><div><span class="footer-label">Help</span><a asp-controller="Bills" asp-action="Index">Bills</a><a asp-controller="Support" asp-action="Index">Support</a><a asp-controller="Profile" asp-action="Index">Profile</a></div></div><div class="container footer-bottom"><span>© @DateTime.Now.Year NEXUS Telecommunication Management System</span><span>Customer experience portal</span></div></footer>
}
<script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body></html>
