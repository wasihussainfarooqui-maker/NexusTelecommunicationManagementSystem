@model IReadOnlyList<Bill>
@{ ViewData["Title"]="My portal"; var connection=(Connection?)ViewBag.Connection; var order=(ServiceOrder?)ViewBag.Order; }
@if(connection is null){<section class="page-hero"><div class="container reveal"><span class="eyebrow">MY NEXUS</span><h1>Welcome back,<br /><em>@Context.Session.GetString("FullName")</em>.</h1><p>You have not activated a connection yet. Choose a plan to start an application.</p><a class="button button-primary" asp-controller="Order" asp-action="Index">Get connected <span>↗</span></a></div></section>}else{<section class="dashboard-hero"><div class="container dash-top reveal"><div><span class="eyebrow">MY NEXUS</span><h1>Welcome back, <em>@connection.CustomerName</em>.</h1><p>Your customer-side service overview.</p></div><a class="button button-primary" asp-controller="Order" asp-action="Index">Add a service <span>+</span></a></div></section><section class="section dashboard-section"><div class="container"><div class="metric-grid"><article class="metric reveal"><span>CONNECTION</span><b>@connection.Status</b><small>@connection.AccountId</small></article><article class="metric reveal"><span>PLAN</span><b>@connection.Plan.ConnectionType</b><small>@connection.Plan.Name</small></article><article class="metric reveal"><span>AMOUNT DUE</span><b>$@connection.AmountDue.ToString("0")</b><small>Current balance</small></article></div><div class="dashboard-grid"><div class="panel reveal"><div class="panel-head"><div><span class="eyebrow">RECENT ORDER</span><h2>@(order?.OrderCode ?? "—")</h2></div><a asp-controller="Track" asp-action="Index" asp-route-code="@(order?.OrderCode)">Track →</a></div>@if(order is not null){<div class="order-summary"><span class="status status-feasible">@order.Status</span><strong>@order.Plan.Name</strong><span>Applied @order.ApplicationDate.ToString("dd MMM yyyy")</span></div><div class="timeline"><span class="done">Application</span><span class="done">Received</span><span class="done">Feasibility</span><span>Connection</span></div>}</div><div class="panel reveal"><div class="panel-head"><div><span class="eyebrow">QUICK ACCESS</span><h2>Manage your service.</h2></div></div><div class="quick-grid"><a asp-controller="Bills" asp-action="Index">Bills <span>→</span></a><a asp-controller="Profile" asp-action="Index">Profile <span>→</span></a><a asp-controller="Support" asp-action="Index">Support <span>→</span></a></div></div></div></div></section>}
