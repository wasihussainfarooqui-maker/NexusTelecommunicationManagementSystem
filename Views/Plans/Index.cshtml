@model IReadOnlyList<Plan>
@{ ViewData["Title"] = "Plans"; }
<section class="page-hero"><div class="container reveal"><span class="eyebrow">NEXUS SERVICES</span><h1>Plans built around<br /><em>your connection.</em></h1><p>Compare customer-facing service plans and start an application in a few steps.</p></div></section>
<section class="section"><div class="container"><div class="plan-grid plan-grid-large">@foreach (var plan in Model) {<article class="plan-card large reveal"><div class="plan-top"><span class="tag">@plan.ConnectionType</span><span class="speed">@plan.Speed</span></div><h3>@plan.Name</h3><p>@plan.Description</p><ul class="check-list"><li>Digital order tracking</li><li>Feasibility status updates</li><li>Customer account visibility</li></ul><div class="price">$@plan.Price.ToString("0") <small>/ @plan.BillingCycle.ToLowerInvariant()</small></div><a class="button button-primary full-button" asp-controller="Order" asp-action="Index" asp-route-planId="@plan.Id">Choose this plan</a></article>}</div></div></section>
