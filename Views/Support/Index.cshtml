@{ ViewData["Title"] = "Support"; }
<section class="page-hero compact"><div class="container reveal"><span class="eyebrow">CUSTOMER SUPPORT</span><h1>How can we<br /><em>help?</em></h1><p>Send a question about your order, connection or billing.</p></div></section>
<section class="section form-section"><div class="container form-layout"><div class="support-copy reveal"><span class="eyebrow">SERVICE DESK</span><h2>We're here for your connection.</h2><p>Tell us what you need and include your order or account ID when relevant.</p><div class="support-points"><span>✓ Order assistance</span><span>✓ Connection questions</span><span>✓ Billing clarification</span></div></div><div class="form-card reveal">@if (TempData["SupportMessage"] is not null) {<div class="success-alert">@TempData["SupportMessage"]</div>}<form asp-action="Index" method="post"><label>Name<input name="name" required placeholder="Your name" /></label><label>Email<input name="email" type="email" required placeholder="you@example.com" /></label><label>Message<textarea name="message" rows="6" required placeholder="How can we help?"></textarea></label><button class="button button-primary full-button" type="submit">Send request <span>↗</span></button></form></div></div></section>
