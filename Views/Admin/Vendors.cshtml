@model IEnumerable<Vendor>
@{ ViewData["Title"] = "Vendors"; }
<div class="page-head reveal"><div><span class="eyebrow">VENDOR MANAGEMENT</span><h1>Supply <em>partners.</em></h1><p>Maintain product manufacturing vendor records and contacts.</p></div></div>
@if (TempData["Message"] is not null) { <div class="alert reveal">✓ @TempData["Message"]</div> }
<div class="panel reveal"><div class="table-wrap"><table><thead><tr><th>Vendor</th><th>Category</th><th>Contact</th><th>Status</th><th>Edit</th></tr></thead><tbody>@foreach (var x in Model) {<tr><td><b>@x.Name</b></td><td>@x.Category</td><td>@x.Contact</td><td><span class="status active">@x.Status</span></td><td><details><summary class="mini-btn">Edit</summary><form asp-action="UpdateVendor" method="post" class="admin-inline-edit"><input type="hidden" name="id" value="@x.Id"/><input name="name" value="@x.Name"/><input name="category" value="@x.Category"/><input name="contact" value="@x.Contact"/><select name="status"><option selected="@(x.Status=="Active"?"selected":null)">Active</option><option selected="@(x.Status=="Inactive"?"selected":null)">Inactive</option></select><button class="mini-btn" type="submit">Save</button></form></details></td></tr>}</tbody></table></div></div>