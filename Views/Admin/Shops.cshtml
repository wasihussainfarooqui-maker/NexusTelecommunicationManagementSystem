@model IEnumerable<RetailShop>
@{ ViewData["Title"] = "Retail Shops"; }
<div class="page-head reveal"><div><span class="eyebrow">RETAIL NETWORK</span><h1>Retail <em>locations.</em></h1><p>Maintain the NEXUS retail outlet directory and contact information.</p></div></div>
@if (TempData["Message"] is not null) { <div class="alert reveal">✓ @TempData["Message"]</div> }
<div class="shop-grid">@foreach (var x in Model) {<article class="shop-card reveal"><span class="shop-icon">⌖</span><span class="eyebrow">RETAIL OUTLET</span><h2>@x.Name</h2><p>@x.City · @x.Contact</p><span class="status active">@x.Status</span><details class="admin-shop-edit"><summary class="mini-btn">Edit outlet</summary><form asp-action="UpdateShop" method="post" class="form"><input type="hidden" name="id" value="@x.Id"/><input name="name" value="@x.Name"/><input name="city" value="@x.City"/><input name="contact" value="@x.Contact"/><select name="status"><option selected="@(x.Status=="Open"?"selected":null)">Open</option><option selected="@(x.Status=="Closed"?"selected":null)">Closed</option></select><button class="btn primary" type="submit">Save outlet</button></form></details></article>}</div>