@model IEnumerable<Equipment>
@{ ViewData["Title"] = "Equipment & Stock"; }
<div class="page-head reveal"><div><span class="eyebrow">INVENTORY CONTROL</span><h1>Equipment & <em>stock.</em></h1><p>Monitor modems, routers, switches and reorder levels. Every operational field is editable by an administrator.</p></div></div>
@if (TempData["Message"] is not null) { <div class="alert reveal">✓ @TempData["Message"]</div> }
<div class="panel reveal"><div class="table-wrap"><table><thead><tr><th>Equipment</th><th>Category</th><th>Vendor</th><th>Quantity</th><th>Reorder</th><th>Status</th><th>Edit</th></tr></thead><tbody>@foreach (var x in Model) {<tr><td><b>@x.Name</b></td><td>@x.Category</td><td>@x.Vendor</td><td><strong>@x.Quantity</strong></td><td>@x.ReorderLevel</td><td><span class="status @(x.Status == "Low stock" ? "due" : "active")">@x.Status</span></td><td><details><summary class="mini-btn">Edit</summary><form asp-action="UpdateEquipment" method="post" class="admin-inline-edit"><input type="hidden" name="id" value="@x.Id"/><input name="name" value="@x.Name" required/><input name="category" value="@x.Category" required/><input name="vendor" value="@x.Vendor"/><input name="quantity" type="number" min="0" value="@x.Quantity"/><input name="reorderLevel" type="number" min="0" value="@x.ReorderLevel"/><button class="mini-btn" type="submit">Save</button></form></details></td></tr>}</tbody></table></div></div>