@model IEnumerable<Plan>
@{ ViewData["Title"] = "Plans"; }
<div class="page-head reveal"><div><span class="eyebrow">PLAN MANAGEMENT</span><h1>Service <em>catalogue.</em></h1><p>Create and maintain telecom plans, prices, speeds and billing cycles.</p></div></div>
@if (TempData["Message"] is not null) { <div class="alert reveal">✓ @TempData["Message"]</div> }
<div class="grid-2"><div class="panel reveal"><div class="panel-title"><div><span class="eyebrow">CREATE PLAN</span><h2>New service plan</h2></div></div><form asp-action="AddPlan" method="post" class="form"><input name="name" required placeholder="Plan name" /><select name="type"><option>Broadband</option><option>DialUp</option><option>Telephone</option></select><input name="price" type="number" step="0.01" required placeholder="Price" /><input name="cycle" required value="Monthly" placeholder="Billing cycle" /><input name="speed" required placeholder="Speed / service" /><button class="btn primary" type="submit">Create plan</button></form></div><div class="panel reveal"><div class="panel-title"><div><span class="eyebrow">CURRENT PLANS</span><h2>@Model.Count() services</h2></div></div><div class="plan-admin-list">@foreach (var x in Model) {<div class="plan-admin"><div><span class="tag">@x.ConnectionType</span><b>@x.Name</b><small>@x.Speed · @x.BillingCycle</small></div><strong>Rs @x.Price.ToString("N0")</strong><details><summary class="mini-btn">Edit</summary><form asp-action="UpdatePlan" method="post" class="admin-inline-edit"><input type="hidden" name="id" value="@x.Id"/><input name="name" value="@x.Name"/><select name="type"><option selected="@(x.ConnectionType==ConnectionType.Broadband?"selected":null)">Broadband</option><option selected="@(x.ConnectionType==ConnectionType.DialUp?"selected":null)">DialUp</option><option selected="@(x.ConnectionType==ConnectionType.Telephone?"selected":null)">Telephone</option></select><input name="price" type="number" step="0.01" value="@x.Price"/><input name="cycle" value="@x.BillingCycle"/><input name="speed" value="@x.Speed"/><input name="description" value="@x.Description"/><label><input name="active" type="checkbox" value="true" checked="@x.IsActive"/> Active</label><button class="mini-btn" type="submit">Save plan</button></form></details></div>}</div></div></div>