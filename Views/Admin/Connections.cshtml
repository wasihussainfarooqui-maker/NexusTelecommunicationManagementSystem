@model IEnumerable<Connection>
@{ ViewData["Title"] = "Connections"; }
<div class="page-head reveal"><div><span class="eyebrow">CONNECTION MANAGEMENT</span><h1>Live service <em>records.</em></h1><p>Monitor active, temporarily inactive and permanently inactive connections.</p></div></div>
<div class="panel reveal"><div class="table-wrap"><table><thead><tr><th>Account ID</th><th>Customer</th><th>Plan</th><th>Connected</th><th>Due</th><th>Status</th><th>Update</th></tr></thead><tbody>@foreach (var x in Model) {<tr><td><b>@x.AccountId</b></td><td>@x.CustomerName</td><td>@x.Plan.Name</td><td>@x.ConnectedAt.ToString("dd MMM yyyy")</td><td>$@x.AmountDue.ToString("N0")</td><td><span class="status @x.Status.ToString().ToLowerInvariant()">@x.Status</span></td><td><form asp-action="UpdateConnection" method="post" class="inline-form"><input type="hidden" name="accountId" value="@x.AccountId" /><select name="status"><option>Active</option><option>TemporarilyInactive</option><option>PermanentlyInactive</option></select><button class="mini-btn" type="submit">Save</button></form></td></tr>}</tbody></table></div></div>
