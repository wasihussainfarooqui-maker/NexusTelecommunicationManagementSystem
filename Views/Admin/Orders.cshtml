@model IEnumerable<ServiceOrder>
@{ ViewData["Title"] = "Orders"; }
<div class="page-head reveal"><div><span class="eyebrow">ORDER MANAGEMENT</span><h1>Connection <em>applications.</em></h1><p>Review applications and update feasibility and installation status.</p></div></div>
@if (TempData["Message"] is not null) { <div class="alert reveal">✓ @TempData["Message"]</div> }
<div class="panel reveal"><div class="table-wrap"><table><thead><tr><th>Order ID</th><th>Customer</th><th>Service</th><th>Applied</th><th>Status</th><th>Update</th></tr></thead><tbody>@foreach (var x in Model) {<tr><td><b>@x.OrderCode</b><small>@x.Address</small></td><td>@x.CustomerName<small>@x.Contact</small></td><td>@x.Plan.Name</td><td>@x.ApplicationDate.ToString("dd MMM yyyy")</td><td><span class="status @x.Status.ToString().ToLowerInvariant()">@x.Status</span></td><td><form asp-action="UpdateOrder" method="post" class="inline-form"><input type="hidden" name="code" value="@x.OrderCode" /><select name="status"><option>Pending</option><option>Feasible</option><option>InstallationScheduled</option><option>Connected</option><option>NotFeasible</option><option>Cancelled</option></select><button class="mini-btn" type="submit">Save</button></form></td></tr>}</tbody></table></div></div>
