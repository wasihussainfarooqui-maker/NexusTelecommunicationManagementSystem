@model IEnumerable<Customer>
@{ ViewData["Title"] = "Customers"; }
<div class="page-head reveal"><div><span class="eyebrow">CUSTOMER DATABASE</span><h1>Customer <em>records.</em></h1><p>Maintain customer contact, city and account information.</p></div></div>
<div class="grid-2"><div class="panel reveal"><div class="panel-title"><div><span class="eyebrow">ADD RECORD</span><h2>New customer</h2></div></div><form asp-action="AddCustomer" method="post" class="form"><input name="name" required placeholder="Full name / company" /><input name="contact" required placeholder="Contact number" /><input name="email" type="email" required placeholder="Email address" /><input name="city" required placeholder="City" /><button class="btn primary" type="submit">Add customer</button></form></div><div class="panel reveal"><div class="panel-title"><div><span class="eyebrow">DIRECTORY</span><h2>@Model.Count() records</h2></div></div><div class="list">@foreach (var x in Model) {<div class="list-row"><div class="avatar">@x.Name.Substring(0,1).ToUpper()</div><div><b>@x.Name</b><small>@x.Email · @x.Contact</small></div><span>@x.City</span><details><summary class="mini-btn">Edit</summary><form asp-action="UpdateCustomer" method="post" class="admin-inline-edit"><input type="hidden" name="id" value="@x.Id"/><input name="name" value="@x.Name"/><input name="email" value="@x.Email"/><input name="contact" value="@x.Contact"/><input name="address" value="@x.Address"/><input name="city" value="@x.City"/><button class="mini-btn" type="submit">Save</button></form></details><form asp-action="ToggleCustomer" method="post" class="inline-form"><input type="hidden" name="id" value="@x.Id" /><input type="hidden" name="active" value="@(x.IsActive ? "false" : "true")" /><button class="mini-btn" type="submit">@(x.IsActive ? "Disable" : "Enable")</button></form></div>}</div></div></div>
