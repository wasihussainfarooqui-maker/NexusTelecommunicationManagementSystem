@model IEnumerable<Bill>
@{ ViewData["Title"] = "Billing"; }
<div class="page-head reveal"><div><span class="eyebrow">BILLING CONTROL</span><h1>Accounts & <em>payments.</em></h1><p>Review generated bills, paid amounts and outstanding dues.</p></div></div>
<div class="metrics mini"><article class="metric reveal"><span>INVOICES</span><strong>@Model.Count()</strong></article><article class="metric reveal"><span>COLLECTED</span><strong>$@Model.Sum(x => x.Paid).ToString("N0")</strong></article><article class="metric reveal"><span>DUE</span><strong>$@Model.Sum(x => x.Due).ToString("N0")</strong></article></div>
<div class="panel reveal"><div class="table-wrap"><table><thead><tr><th>Bill</th><th>Account</th><th>Amount</th><th>Paid</th><th>Due</th><th>Due date</th><th>Status</th><th>Payment</th></tr></thead><tbody>@foreach (var x in Model) {<tr><td><b>@x.BillNumber</b></td><td>@x.AccountId</td><td>$@x.Amount.ToString("N0")</td><td>$@x.Paid.ToString("N0")</td><td><b>$@x.Due.ToString("N0")</b></td><td>@x.DueDate.ToString("dd MMM yyyy")</td><td><span class="status status-@x.Status.ToLowerInvariant()">@x.Status</span></td><td><form asp-action="MarkBillPaid" method="post" class="inline-form"><input type="hidden" name="id" value="@x.Id" /><input name="amount" type="number" step="0.01" min="0" max="@x.Amount" value="@x.Paid" style="width:90px" /><button class="mini-btn" type="submit">Save</button></form></td></tr>}</tbody></table></div></div>
<div class="note reveal">Service tax is maintained according to the project specification and is charged on the generated bill.</div>
