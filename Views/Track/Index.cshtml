@model TrackViewModel
@{ ViewData["Title"] = "Track connection"; var found = Model.Order is not null || Model.Connection is not null; }
<section class="page-hero compact"><div class="container reveal"><span class="eyebrow">CONNECTION TRACKING</span><h1>Check your<br /><em>service status.</em></h1><p>Enter the unique order ID or account ID supplied by NEXUS.</p></div></section>
<section class="section track-page"><div class="container narrow"><form asp-action="Index" method="post" class="lookup-card reveal"><label>Order ID or account ID<input asp-for="Code" placeholder="B0000000001 or B001000000000001" autofocus /><span>Order IDs identify applications. Account IDs identify active connections.</span></label><button class="button button-primary" type="submit">Search status</button></form>@if (!string.IsNullOrWhiteSpace(Model.Code)) {<div class="result-card reveal">@if (found) { if (Model.Order is not null) {<div class="result-head"><div><span class="eyebrow">ORDER @Model.Order.OrderCode</span><h2>@Model.Order.Plan.Name</h2></div><span class="status status-@Model.Order.Status.ToString().ToLowerInvariant()">@Model.Order.Status</span></div><div class="detail-grid"><div><span>Customer</span><b>@Model.Order.CustomerName</b></div><div><span>Applied</span><b>@Model.Order.ApplicationDate.ToString("dd MMM yyyy")</b></div><div><span>Service</span><b>@Model.Order.Plan.ConnectionType</b></div><div><span>Note</span><b>@Model.Order.FeasibilityNote</b></div></div><div class="timeline"><span class="done">Application</span><span class="done">Received</span><span class="@(Model.Order.Status is OrderStatus.Feasible or OrderStatus.Connected ? "done" : "")">Feasibility</span><span class="@(Model.Order.Status == OrderStatus.Connected ? "done" : "")">Connected</span></div>} if (Model.Connection is not null) {<hr /><div class="result-head"><div><span class="eyebrow">ACCOUNT @Model.Connection.AccountId</span><h2>Active connection</h2></div><span class="status status-active">@Model.Connection.Status</span></div><div class="detail-grid"><div><span>Plan</span><b>@Model.Connection.Plan.Name</b></div><div><span>Connected</span><b>@Model.Connection.ConnectedAt.ToString("dd MMM yyyy")</b></div><div><span>Monthly plan</span><b>$@Model.Connection.Plan.Price.ToString("0")</b></div><div><span>Current due</span><b>$@Model.Connection.AmountDue.ToString("0")</b></div></div>}} else {<div class="empty-state"><div>?</div><h2>No matching record</h2><p>We could not find an order or account with <b>@Model.Code</b>. Check the ID and try again.</p></div>}</div>}</div></section>
