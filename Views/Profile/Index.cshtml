@model Customer
@{ ViewData["Title"]="Profile"; var initial=string.IsNullOrWhiteSpace(Model?.Name)?"N":Model.Name.Substring(0,1).ToUpperInvariant(); }
<section class="page-hero compact"><div class="container reveal"><span class="eyebrow">MY PROFILE</span><h1>Your details,<br /><em>in one place.</em></h1></div></section>
<section class="section"><div class="container narrow"><div class="profile-card reveal"><div class="avatar">@initial</div><div><span class="eyebrow">CUSTOMER</span><h2>@Model.Name</h2><p>Database-backed customer account.</p></div><div class="profile-fields"><div><span>Username</span><b>@Model.Username</b></div><div><span>Email</span><b>@Model.Email</b></div><div><span>Contact</span><b>@Model.Contact</b></div><div><span>Account ID</span><b>@(string.IsNullOrWhiteSpace(Model.AccountId)?"Not connected yet":Model.AccountId)</b></div><div><span>Service area</span><b>@Model.City</b></div><div><span>Address</span><b>@Model.Address</b></div></div></div></div></section>
